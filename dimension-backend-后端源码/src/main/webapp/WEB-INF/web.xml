    <!--管理员认证过滤器-->
    <filter>
        <filter-name>AdminAuthenticationFilter</filter-name>
        <filter-class>com.dimension.filter.AdminAuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
</web-app>