<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!--跨域处理过滤器 // 因为是前后端分离，前端单独一个项目，所以请求会跨域，该过滤器配置允许跨域请求即可 // 需要配置在第一个作为第一个过滤器-->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.dimension.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--响应编码过滤器，统一设置响应编码为application/json，因为要回传JSON数据给前端 // 放置在CorsFilter后面，表示后于CorsFilter执行-->
    <filter>
        <filter-name>CharacterFilter</filter-name>
        <filter-class>com.dimension.filter.CharacterFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--用户认证过滤器-->
