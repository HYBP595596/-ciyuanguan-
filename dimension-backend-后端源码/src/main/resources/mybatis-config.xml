<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <!--引入jdbc配置文件-->
    <properties resource="jdbc.properties"></properties>

    <!--配置全局环境-->
    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/> <!--驼峰命名-->
        <setting name="logImpl" value="STDOUT_LOGGING"/> <!--日志-->
        <setting name="cacheEnabled" value="false" /> <!--关闭二级缓存-->
        <setting name="localCacheScope" value="STATEMENT"/> <!--关闭一级缓存-->
    </settings>

    <!--配置类别名-->
    <typeAliases>
        <package name="com.dimension.entity"/>
    </typeAliases>

    <!--设置连接数据库的环境-->
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
<!--            <dataSource type="POOLED">-->
            <dataSource type="POOLED">
                <property name="driver" value="${jdbc.driver}"/>
                <property name="url" value="${jdbc.url}"/>
                <property name="username" value="${jdbc.username}"/>
                <property name="password" value="${jdbc.password}"/>

                <!-- 连接池上限必须低于 MySQL 的 max_connections(151)，
                     原来写 1000 一旦有泄漏就会把数据库连接打满 -->
                <property name="poolMaximumActiveConnections" value="20"/>
                <property name="poolMaximumIdleConnections" value="10"/>
                <!-- 取连接最长等待 20s，等不到就抛错，避免请求无限堆积 -->
                <property name="poolMaximumCheckoutTime" value="20000"/>
                <property name="poolTimeToWait" value="20000"/>
                <!-- 空闲连接探活，防止 MySQL 主动断开后拿到死连接 -->
                <property name="poolPingEnabled" value="true"/>
                <property name="poolPingQuery" value="SELECT 1"/>
            </dataSource>
        </environment>
    </environments>

    <!--引入映射文件-->
    <mappers>
<!--        <package name="com/lx/mapper"/>--> <!--这个不好用啊-->
        <mapper resource="mapper/FollowMapper.xml"/>
        <mapper resource="mapper/FollowMapper.xml"/>
        <mapper resource="mapper/AdminMapper.xml"/>
        <mapper resource="mapper/ImageCategoryMapper.xml"/>
        <mapper resource="mapper/CommentMapper.xml"/>
        <mapper resource="mapper/WatchHistoryMapper.xml"/>
        <mapper resource="mapper/ImageBookmarkMapper.xml"/>
        <mapper resource="mapper/ImageMapper.xml"/>
        <mapper resource="mapper/TagImageRelationMapper.xml"/>
        <mapper resource="mapper/TagMapper.xml"/>
        <mapper resource="mapper/UserMapper.xml"/>
        <mapper resource="mapper/ImageRatingMapper.xml"/>
        <mapper resource="mapper/CommissionMapper.xml"/>
        <mapper resource="mapper/MessageMapper.xml"/>
        <mapper resource="mapper/PaymentMapper.xml"/>
        <mapper resource="mapper/NoticeMapper.xml"/>
        <mapper resource="mapper/InboxMapper.xml"/>
    </mappers>
</configuration>