<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dimension.mapper.AdminMapper">
    <select id="adminLogin" resultType="com.dimension.entity.Admin">
        select * from dimension_admin where username = #{username} and password = #{password}
    </select>
</mapper>