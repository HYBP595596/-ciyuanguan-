    <select id="userLogin" resultType="com.dimension.entity.User">
        select * from dimension_user where username = #{username} and password = #{password}
    </select>

    <update id="updateUserAvatar">
        UPDATE dimension_user
        SET avatar = #{avatar}
        WHERE id = #{userId}
    </update>
    <update id="updateUserInfo">
        UPDATE dimension_user
        SET nickname    = #{nickname},
            description = #{description},
            sex         = #{sex},
            birthday    = #{birthday}
        WHERE id = #{userId}
    </update>
    <update id="updateUserPassword">
        UPDATE dimension_user
        SET PASSWORD = #{password}
        WHERE id = #{userId}
    </update>

    <select id="isExistByNickname" resultType="int">
        SELECT COUNT(*)
        FROM dimension_user
        WHERE nickname = #{nickname}
    </select>

    <select id="isExistByUsername" resultType="int">
        SELECT COUNT(*)
        FROM dimension_user
        WHERE username = #{username}
    </select>

    <select id="getUserInfo" resultType="com.dimension.entity.User">
        SELECT *
        FROM dimension_user
        WHERE id = #{userId}
    </select>

    <select id="getUserTableWithNickname" resultType="com.dimension.entity.User">
        SELECT *
        FROM dimension_user
        WHERE nickname LIKE CONCAT("%",#{nickname},"%")
            LIMIT #{pageNum},#{pageSize}
    </select>

    <select id="getTotalWithNickname" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM dimension_user
        WHERE nickname LIKE CONCAT("%",#{nickname},"%")
    </select>

    <insert id="addRegisterUser" parameterType="com.dimension.entity.User">
        INSERT INTO dimension_user (nickname, username, password,
                                    status, sex, birthday, avatar)
        VALUES (#{user.nickname}, #{user.username}, #{user.password},
                #{user.status}, #{user.sex}, #{user.birthday}, #{user.avatar})
    </insert>

    <select id="getUserTableWithUsername" resultType="com.dimension.entity.User">
        SELECT *
        FROM dimension_user
        WHERE username = #{username}
    </select>

    <select id="getUserTableWithNoCondition" resultType="com.dimension.entity.User">
        SELECT *
        FROM dimension_user
                 limit #{pageNum}, #{pageSize}
    </select>

    <select id="totalList" resultType="java.lang.Long">
        SELECT COUNT(*) FROM dimension_user
    </select>

    <update id="forbidUser">
        UPDATE dimension_user SET dimension_user.status = 1 WHERE id = #{userId}
    </update>

    <update id="resumeUser">
        UPDATE dimension_user SET dimension_user.status = 0 WHERE id = #{userId}
    </update>

    <update id="updateUserCover">
        UPDATE dimension_user SET cover_image = #{coverImage} WHERE id = #{userId}
    </update>
</mapper>