<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dimension.mapper.TagMapper">

    <select id="getAllTag" resultType="com.dimension.entity.Tag">
        select * from dimension_tag
    </select>

    <select id="getTagByName" resultType="com.dimension.entity.Tag">
        SELECT * FROM dimension_tag WHERE name = #{name} LIMIT 1
    </select>

    <insert id="insertTag" parameterType="com.dimension.entity.Tag" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dimension_tag (name) VALUES (#{name})
    </insert>


</mapper>